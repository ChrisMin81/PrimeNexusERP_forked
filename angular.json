{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "sakai-ng": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": "dist/sakai-ng",
                        "index": "src/index.html",
                        "browser": "src/main.ts",
                        "polyfills": [
                            "zone.js"
                        ],
                        "tsConfig": "tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            {
                                "glob": "**/*",
                                "input": "public"
                            }
                        ],
                        "styles": [
                            "src/assets/styles.scss"
                        ],
                        "scripts": []
                    },
                    "configurations": {
                        "production": {
                            "outputHashing": "all"
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "production": {
                            "buildTarget": "sakai-ng:build:production"
                        },
                        "development": {
                            "buildTarget": "sakai-ng:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "extract-i18n": {
                    "builder": "@angular/build:extract-i18n"
                },
                "test": {
                    "builder": "@angular/build:unit-test",
                    "options": {
                        "buildTarget": "sakai-ng:build:development",
                        "setupFiles": [
                            "src/test-setup.ts"
                        ],
                        "tsConfig": "tsconfig.spec.json",
                        "runner": "vitest"
                    }
                }
            }
        },
        "api": {
            "projectType": "library",
            "root": "projects/api",
            "sourceRoot": "projects/api",
            "prefix": "api",
            "architect": {
                "build": {
                    "builder": "@angular/build:ng-packagr",
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/api/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/api/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                }
            }
        },
        "camba-shared": {
          "projectType": "library",
          "root": "projects/camba-shared",
          "sourceRoot": "projects/camba-shared",
          "prefix": "camba",
          "architect": {
            "build": {
              "builder": "@angular/build:ng-packagr",
              "configurations": {
                "production": {
                  "tsConfig": "projects/camba-shared/tsconfig.lib.prod.json"
                },
                "development": {
                  "tsConfig": "projects/camba-shared/tsconfig.lib.json"
                }
              },
              "defaultConfiguration": "production"
            },
              "test": {
                  "builder": "@angular/build:unit-test",
                  "options": {
                      "buildTarget": "camba-shared:build:development",
                      "setupFiles": [
                          "projects/camba-shared/test-setup.ts"
                      ],
                      "tsConfig": "projects/camba-shared/tsconfig.spec.json",
                      "runner": "vitest",
                      "include": [
                          "**/*.spec.ts"
                      ]
                  }
              }
          }
        }
    },
    "cli": {
      "analytics": false
    }
}
